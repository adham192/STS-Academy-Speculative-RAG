cat > .dockerignore << 'EOF'
# Secrets: compose passes these in via env_file, never bake them into an image
.env
.env.*

# VCS and tooling
.git
.gitignore
.vscode/
.idea/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime data (mounted as Docker volumes, not copied)
src/session3/chroma_db/
src/session3/pdfs/
src/session3/JSON-chat-history/

# Not needed inside the images
src/session3/JSON-evaluation-results/
src/session3/JSON-experiment-results/
src/session3/JSON-Test-cases/
src/session3/App-Log-Pic/
*.log
README.md
docker-compose.yaml
Dockerfile
.dockerignore
EOF